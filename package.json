{
  "name": "snapback",
  "version": "0.1.0",
  "description": "Undo for any coding agent. Snapshots your project into a shadow git repo so one command rolls back what the agent did.",
  "type": "module",
  "bin": {
    "snapback": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "npm run build"
  },
  "keywords": [
    "undo",
    "checkpoint",
    "snapshot",
    "rollback",
    "coding-agent",
    "codex",
    "claude-code",
    "cli"
  ],
  "author": "Abel Yagubyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abelo9996/snapback.git"
  },
  "homepage": "https://github.com/Abelo9996/snapback#readme",
  "bugs": "https://github.com/Abelo9996/snapback/issues",
  "dependencies": {
    "cac": "^6.7.14",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
